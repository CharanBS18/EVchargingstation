# =====================================================================
# EV ChargeHub — local environment
# Copy this file to `.env` and fill in real values before `npm run dev`.
# =====================================================================

# ---- Supabase (required) ----------------------------------------------
# Create a free project at https://supabase.com. Copy the URL and the
# publishable/anon key from Project Settings → API. The migrations in
# supabase/migrations/ can be applied with the Supabase CLI:
#   npx supabase link --project-ref <ref>
#   npx supabase db push
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Server-side copies (same values). Used by SSR + server functions.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Service-role key (server-only, never expose to browser). Found in
# Project Settings → API → service_role. Needed for admin operations
# (role grants, webhook writes, admin bootstrap).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ---- AI chat (chatbot on /helpline) -----------------------------------
# Provider is configurable. Default: OpenAI.
#   AI_PROVIDER=openai   → uses OPENAI_API_KEY, defaults to gpt-4o-mini
#   AI_PROVIDER=lovable  → uses LOVABLE_API_KEY (Lovable AI Gateway)
#   Or override AI_BASE_URL + AI_API_KEY + AI_MODEL for any
#   OpenAI-compatible endpoint (Groq, Together, local Ollama, etc.).
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# LOVABLE_API_KEY=""

# ---- Razorpay (payments) ----------------------------------------------
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Admin bootstrap --------------------------------------------------
# Used by /admin gate + admin.functions.ts. Any strong random string works.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_SECRET_KEY="change-me-long-random"

# ---- Site URL (sitemap, absolute links) -------------------------------
SITE_URL="http://localhost:3000"

# ---- Capacitor / Android (optional) -----------------------------------
# URL the Android WebView loads. Use 10.0.2.2 for the emulator loopback.
CAP_SERVER_URL="http://10.0.2.2:3000"
